# Stage 1 - local development only
# Never commit a real API key.
OPENAI_API_KEY=

# PyAudio input device index for the physical microphone.
MIC_DEVICE_INDEX=1

# Streaming transcription tuning.
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_TRANSCRIPTION_DELAY=low

# Optional overrides for technical-meeting vocabulary.
# The application already provides a built-in technical prompt and keyword set.
# OPENAI_TRANSCRIPTION_PROMPT=
# OPENAI_TRANSCRIPTION_KEYWORDS=
