# ---------------------------------------------------------------------------
# Stage 1 - Live subtitles (local, no OpenAI API required)
# ---------------------------------------------------------------------------

# PyAudio input device index for the physical microphone.
MIC_DEVICE_INDEX=-1

# Faster-Whisper defaults for an English-only meeting.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1

# Caption timing.
SUBTITLE_PARTIAL_INTERVAL_SECONDS=0.45
SUBTITLE_PARTIAL_MIN_SECONDS=0.9
WHISPER_PARTIAL_WINDOW_SECONDS=4.0
SUBTITLE_SPEECH_END_MS=700
SUBTITLE_MAX_UTTERANCE_SECONDS=8

# Microphone false-positive protection.
# YOU is intentionally stricter than MEETING to avoid room noise / speaker
# bleed creating fake captions when you are silent.
MIC_VAD_MODE=3
MIC_MIN_DBFS=-40
MIC_SPEECH_START_MS=120
MIC_MIN_VOICED_MS=180

# System/Teams audio is more permissive so short remote phrases are retained.
MEETING_VAD_MODE=2
MEETING_SPEECH_START_MS=120
MEETING_MIN_VOICED_MS=240

# Prefer YOU while the physical microphone is detecting local speech. This
# suppresses the Teams/system loopback briefly so your own voice is not also
# labelled as MEETING.
LOCAL_SPEECH_GATE_HOLD_MS=800

# Optional vocabulary override.
# WHISPER_INITIAL_PROMPT=

# ---------------------------------------------------------------------------
# Stage 2 - Technical interview assistant
# Independent from Stage 1. Uses a multilingual Whisper model with automatic
# language detection so English and Spanish can be mixed in one interview.
# Groq receives only text/context for reasoning and answers.
# ---------------------------------------------------------------------------

INTERVIEW_WHISPER_MODEL=base
INTERVIEW_TRANSCRIPTION_LANGUAGE=auto
# INTERVIEW_WHISPER_INITIAL_PROMPT=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=420

# Answer language shown in the Assistant tab.
ASSISTANT_LANGUAGE=en
AI_PROVIDER=groq

# Recent context used to resolve follow-up questions.
INTERVIEW_CONTEXT_TURNS=24
INTERVIEW_QUESTION_DEBOUNCE_SECONDS=1.2
